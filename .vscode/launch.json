{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Python",
      "type": "debugpy",
      "request": "launch",
      "code": "from src import main; main()",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "linux": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
    }
  ]
}
